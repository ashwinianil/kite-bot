<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kitebot.papertrade</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_FULL_PATH_TO_REPO/scripts/scheduled_paper_trade.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_FULL_PATH_TO_REPO/logs/launchd_papertrade_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_FULL_PATH_TO_REPO/logs/launchd_papertrade_stderr.log</string>
</dict>
</plist>
