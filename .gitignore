# Secrets — never commit these
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs
logs/*.log
logs/*.csv
logs/*.png

# Generated market data — regenerable via update_data.py / export_to_excel.py,
# not source, and will grow large over time. Not committed to git.
data/csv/*.csv
data/csv/archived/*.csv
data/excel/**/*.xlsx

# NOTE: data/options_csv/ is intentionally NOT gitignored, unlike the data
# above. Options price history is collected prospectively and is
# IRREPLACEABLE — Kite's historical API can't retroactively give us past
# option prices, unlike index/stock candles. Committing it gives free
# backup/history for data that can't be regenerated if lost.

# Generated instrument token cache — regenerate via get_instrument_tokens.py
config/instrument_tokens.csv

# Paper trading position state — transient runtime state (what's currently
# open right now), not history. Regenerable in the sense that losing it
# just means the bot treats itself as flat on next run — not ideal, but
# not catastrophic like losing trade history would be. Gitignored.
data/paper_positions.json

# Paper trading TRADE LOG (closed trades) is intentionally NOT gitignored —
# like data/options_csv/, this is irreplaceable track record, not
# regenerable data. Committing it preserves history.

# OS
.DS_Store
