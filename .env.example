# Rename this file to .env and fill in your actual values
# NEVER commit the real .env file to git — it's already in .gitignore

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# This gets filled in automatically by login.py (or headless_login.py) each day
KITE_ACCESS_TOKEN=

# --- Only needed for scripts/headless_login.py (automated, no-browser login) ---
# Leave these BLANK if you're only ever running scripts/login.py by hand
# (e.g. on your local Mac). Fill them in only for unattended/remote setups
# (e.g. a VPS) where you can't open a browser to log in each day.
#
# SECURITY: these are meaningfully more sensitive than the API key/secret
# above — anyone with this file could fully log into your trading account.
# Treat this .env file (and the machine it lives on) accordingly: SSH-key-only
# access, no other logins, disk encryption if possible.

# Your Zerodha login ID (the one you type on the Kite login page)
KITE_USER_ID=

# Your Zerodha account password
KITE_PASSWORD=

# The PERMANENT TOTP secret — NOT the 6-digit code you see in the Kite app
# (that one rotates every 30 seconds and can't be stored). This is the
# fixed secret key shown ONCE when you set up/reset 2FA, usually as text
# below a QR code. Find/reset it at: Kite Console > Account > Security > 2FA
KITE_TOTP_SECRET=
