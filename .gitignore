# Secrets — never commit these
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs
logs/*.log
logs/*.csv

# Generated market data — regenerable via update_data.py / export_to_excel.py,
# not source, and will grow large over time. Not committed to git.
data/csv/*.csv
data/csv/archived/*.csv
data/excel/**/*.xlsx

# NOTE: data/options_csv/ is intentionally NOT gitignored, unlike the data
# above. Options price history is collected prospectively and is
# IRREPLACEABLE — Kite's historical API can't retroactively give us past
# option prices, unlike index/stock candles. Committing it gives free
# backup/history for data that can't be regenerated if lost.

# Generated instrument token cache — regenerate via get_instrument_tokens.py
config/instrument_tokens.csv

# OS
.DS_Store
